{
  "name": "figloom",
  "version": "0.0.2",
  "private": true,
  "description": "Source skills and managed Figloom plugin bundles for Claude Code, Codex, and Cursor.",
  "repository": {
    "type": "git",
    "url": "https://github.com/hungify/skills.git"
  },
  "license": "MIT",
  "scripts": {
    "changeset": "changeset",
    "sync": "npm run sync:version && npm run sync:figloom",
    "sync:figloom": "node scripts/sync-figloom.mjs",
    "sync:version": "node scripts/sync-version.mjs",
    "check:bundle": "node scripts/validate-release.mjs",
    "test:hooks": "node --test plugins/figloom/hooks/check-component-registry-drift.test.mjs",
    "test:registry": "node skills/figma-component-registry/scripts/figma-component-registry-tests.mjs",
    "test:component": "node skills/figma-implement-component/scripts/figma-implement-component-pressure.mjs",
    "validate": "npm run check:bundle && npm run test:hooks && npm run test:registry && npm run test:component",
    "version": "changeset version && npm run sync && npm run validate",
    "release": "npm run validate && changeset tag"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.8",
    "@babel/types": "^7.29.8",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "diff": "^9.0.0",
    "esbuild": "^0.25.12",
    "proper-lockfile": "^4.1.2",
    "react-docgen-typescript": "^2.2.2",
    "typescript": "^5.5.4",
    "vue": "^3.5.40",
    "vue-component-meta": "^3.3.8"
  },
  "packageManager": "npm@11.17.0"
}
