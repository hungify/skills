{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://internal/figma-implement-component/figma-options.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "groups"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["componentPath", "groupName", "propName", "figmaNodeId", "options"],
        "properties": {
          "componentPath": { "type": "string", "minLength": 1 },
          "groupName": { "type": "string", "minLength": 1 },
          "propName": { "type": "string", "minLength": 1 },
          "figmaNodeId": { "type": ["string", "null"] },
          "options": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
