{
  "description": "Check Figma component registry drift after Codex edits component source.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/check-component-registry-drift.mjs\"",
            "timeout": 30,
            "statusMessage": "Checking Figma component registry drift"
          }
        ]
      }
    ]
  }
}
