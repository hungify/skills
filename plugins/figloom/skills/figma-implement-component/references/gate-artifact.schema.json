{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://internal/figma-implement-component/gate-artifact.schema.json",
  "title": "component-implementation.json (schemaVersion 3)",
  "description": "Gate artifact generated by figma-implement-component, placed next to the component file (<name>.implementation.json). See SKILL.md's 'Gate artifact schema' section.",
  "type": "object",
  "required": [
    "schemaVersion",
    "component",
    "registryRef",
    "registryFreshness",
    "classification",
    "dedup",
    "harness",
    "coverage",
    "behavior",
    "figloomEvidence",
    "status",
    "generatedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 3 },
    "component": {
      "type": "object",
      "required": ["name", "filePath"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "filePath": { "type": "string", "minLength": 1 }
      }
    },
    "registryRef": {
      "type": "object",
      "required": ["path", "exportName"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "exportName": { "type": "string", "minLength": 1 }
      }
    },
    "registryFreshness": {
      "type": "object",
      "required": ["schemaVersion", "component", "registryPath", "registryRoot", "sourceRoot", "registryHash", "checkedAt", "check", "verifySource"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "component": { "type": "string", "minLength": 1 },
        "registryPath": { "type": "string", "minLength": 1 },
        "registryRoot": { "type": "string", "minLength": 1 },
        "sourceRoot": { "type": "string", "minLength": 1 },
        "registryHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "checkedAt": { "type": "string", "format": "date-time" },
        "check": { "$ref": "#/$defs/freshnessCommand" },
        "verifySource": { "$ref": "#/$defs/freshnessCommand" }
      }
    },
    "classification": {
      "type": "object",
      "required": ["type", "reasoning"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "design-system-component" },
        "reasoning": { "type": "string", "minLength": 1 }
      }
    },
    "dedup": {
      "type": "array",
      "description": "Only lists props that ACTUALLY have 2+ duplicated nodes. Empty array if no prop is duplicated.",
      "items": {
        "type": "object",
        "required": ["prop", "canonicalFigmaNodeId", "canonicalPath", "redundant"],
        "additionalProperties": false,
        "properties": {
          "prop": { "type": "string", "minLength": 1 },
          "canonicalFigmaNodeId": { "type": "string", "minLength": 1 },
          "canonicalPath": { "type": "string", "minLength": 1 },
          "redundant": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["figmaNodeId", "path", "coverageRole"],
              "additionalProperties": false,
              "properties": {
                "figmaNodeId": { "type": "string", "minLength": 1 },
                "path": { "type": "string", "minLength": 1 },
                "coverageRole": { "const": "redundant-view" }
              }
            }
          }
        }
      }
    },
    "harness": {
      "type": "object",
      "required": ["showcaseFilePath", "testidsFilePath", "totalStates"],
      "additionalProperties": false,
      "properties": {
        "showcaseFilePath": { "type": "string", "minLength": 1 },
        "testidsFilePath": { "type": "string", "minLength": 1 },
        "totalStates": { "type": "integer", "minimum": 0 }
      }
    },
    "coverage": {
      "type": "object",
      "required": ["direction", "visualGaps", "needsHumanReview"],
      "additionalProperties": false,
      "properties": {
        "direction": { "const": "figma-to-code" },
        "visualGaps": { "type": "array", "items": { "type": "string" } },
        "needsHumanReview": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "Free-form (comes from dedup 5a or coverage 5c) but must always have a 'prop' and 'reason' field so human review is fast.",
            "required": ["prop", "reason"],
            "properties": {
              "prop": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "behavior": {
      "type": "object",
      "required": ["schemaVersion", "cases"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["bindingPath", "bindingIdentity", "kind", "status", "evidence"],
            "additionalProperties": false,
            "properties": {
              "bindingPath": { "type": "string", "minLength": 1 },
              "bindingIdentity": { "$ref": "#/$defs/bindingIdentity" },
              "kind": { "enum": ["interaction", "a11y", "visual-state", "not-applicable"] },
              "status": { "enum": ["passed", "waived"] },
              "evidence": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "figloomEvidence": {
      "type": "array",
      "description": "Empty is only valid when harness.totalStates == 0 (no visual state needs Figloom verification); otherwise needs >=1 (see allOf).",
      "items": { "$ref": "#/$defs/figloomEvidence" }
    },
    "status": {
      "enum": ["pending-human-review", "done"],
      "description": "Always defaults to 'pending-human-review' when first generated. Only an agent or human reviewer changes it to 'done' after manual confirmation (see 'Definition of Done', item 4)."
    },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "done" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "coverage": {
            "properties": {
              "visualGaps": { "maxItems": 0 },
              "needsHumanReview": { "maxItems": 0 }
            },
            "required": ["visualGaps", "needsHumanReview"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "harness": {
            "properties": { "totalStates": { "minimum": 1 } },
            "required": ["totalStates"]
          }
        },
        "required": ["harness"]
      },
      "then": {
        "properties": { "figloomEvidence": { "minItems": 1 } }
      }
    }
  ],
  "$defs": {
    "bindingIdentity": {
      "type": "object",
      "required": ["componentPath", "groupName", "propName", "figmaNodeId"],
      "additionalProperties": false,
      "properties": {
        "componentPath": { "type": "string", "minLength": 1 },
        "groupName": { "type": "string", "minLength": 1 },
        "propName": { "type": "string", "minLength": 1 },
        "figmaNodeId": { "type": ["string", "null"] }
      }
    },
    "freshnessCommand": {
      "type": "object",
      "required": ["status", "command", "stdout"],
      "additionalProperties": false,
      "properties": {
        "status": { "const": "passed" },
        "command": { "type": "string", "minLength": 1 },
        "stdout": { "type": "string" }
      }
    },
    "figloomEvidence": {
      "type": "object",
      "required": ["verificationArtifactPath", "verificationArtifactHash"],
      "additionalProperties": false,
      "properties": {
        "verificationArtifactPath": { "type": "string", "minLength": 1 },
        "verificationArtifactHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  }
}
